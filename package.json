{
  "name": "poe-cn-helper",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "description": "流放之路物品制作助手工具",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "crafting:data": "node scripts/generateCraftingData.js",
    "crafting:data:missing": "node scripts/generateCraftingData.js --fetch-missing",
    "crafting:data:refresh": "node scripts/generateCraftingData.js --live",
    "skills:data": "node scripts/generateSkillGemData.js",
    "skills:data:missing": "node scripts/generateSkillGemData.js --fetch-missing",
    "skills:data:refresh": "node scripts/generateSkillGemData.js --live",
    "unique-items:data": "node scripts/generateUniqueItemSnapshot.js",
    "unique-items:data:missing": "node scripts/generateUniqueItemSnapshot.js --fetch-missing",
    "unique-items:data:refresh": "node scripts/generateUniqueItemSnapshot.js --live",
    "runtime:prepare": "node scripts/runtime/prepare.js",
    "runtime:verify": "node scripts/runtime/verify.js",
    "dev": "vite",
    "electron:dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "electron:build": "npm run build && electron-builder --win nsis --x64",
    "release:check": "node scripts/release/checkVersion.js",
    "release:checksum": "node scripts/release/checksum.js",
    "release:smoke": "node scripts/release/smokePackage.js",
    "release:win": "npm run release:check && npm run runtime:prepare && npm run runtime:verify && npm run build && electron-builder --win nsis --x64 && npm run release:smoke && npm run release:checksum"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "cheerio": "^1.0.0",
    "element-plus": "^2.6.3",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "extract-zip": "2.0.1",
    "less": "^4.4.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^5.1.4"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.exilehelper.app",
    "productName": "流放助手",
    "artifactName": "PoE-CN-Helper-${version}-win-${arch}-setup.${ext}",
    "beforePack": "scripts/runtime/beforePack.cjs",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/assets/crafting-raw/**/*",
      "!electron/assets/skill-raw/**/*",
      "!electron/assets/unique-items-raw/**/*",
      "scripts/**/*",
      "src/assets/images/LOGO.png",
      "src/utils/bagConfig.js",
      "src/utils/electronAccelerator.js",
      "src/utils/inventorySettings.js",
      "src/utils/operationDelay.js",
      "src/utils/stashGridCalibration.js",
      "src/utils/stashPickupConfig.js",
      "src/utils/stashTabSelection.js",
      "electron/assets/item-footprints.json",
      "package.json",
      "LICENSE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "src/assets/scripts/bag_auto_stash_template.py",
        "to": "bag_auto_stash_template.py"
      },
      {
        "from": "src/assets/scripts/chaos_recipe_pick_template.py",
        "to": "chaos_recipe_pick_template.py"
      },
      {
        "from": "src/assets/scripts/stash_pickup_template.py",
        "to": "stash_pickup_template.py"
      },
      {
        "from": "src/assets/scripts/stash_tab_selector.py",
        "to": "stash_tab_selector.py"
      },
      {
        "from": ".runtime/python-runtime",
        "to": "python-runtime"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator",
      "icon": "src/assets/images/LOGO-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
