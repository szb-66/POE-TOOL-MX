  {
    "table": "clientstrings",
    "id": "ItemDescriptionHeistContract",
    "field": "Text",
    "en": "Give this Contract to Adiyah in the Rogue Harbour to embark on the Heist.",
    "kind": "dat",
    "sourceHash": "208d79d2ffb5c37018518bd2c8332bbf559f0c3dad01536f49f4d9a17032b94f",
    "tw": "將此契約書交給在盜賊港灣的阿迪雅，以開始劫盜任務。",
    "cn": "在黄金港将契约交给艾蒂娅，开启夺宝冒险。"
  },
  {
    "table": "clientstrings",
    "id": "ItemDescriptionHeistBlueprint",
    "field": "Text",
    "en": "Use Intelligence to Reveal additional Wings and Rooms by talking to certain NPCs in the Rogue Harbour. Give this Blueprint to Adiyah to embark on the Grand Heist.",
    "kind": "dat",
    "sourceHash": "82467bc83697152510ab044c37fc88b94788b53a81092d2a0921e635c5dceb49",
    "tw": "在盜賊港灣與特定 NPC 對話，使用資訊來發現額外的側廂和房間。將此藍圖交給阿迪雅以開始劫盜之星。",
    "cn": "在黄金港跟 NPC 对话，运用智慧破解更多侧厅和密室。将该蓝图交给艾蒂娅开启大型夺宝冒险。"
  }
